APP_NAME=Website & API Uptime Monitor
APP_ENV=development
DATABASE_URL=postgresql+psycopg://uptime_user:uptime_password@db:5432/uptime_monitor
CORS_ORIGINS=http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10

# Incident Detection Configuration
INCIDENT_FAILURE_THRESHOLD=3
INCIDENT_RECOVERY_THRESHOLD=2
